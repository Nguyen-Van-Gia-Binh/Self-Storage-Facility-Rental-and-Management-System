# ==============================================================================
# Self-Storage Frontend Environment Configuration Template
# ==============================================================================

# API Base URL (khớp với Vite proxy '/api' chuyển tiếp sang http://localhost:8080/api/v1)
VITE_API_BASE_URL=/api/v1

# Cấu hình Google OAuth Client ID
VITE_GOOGLE_CLIENT_ID=109364799143-s4gsllthdljfshrivptd03aog9jf3bvr.apps.googleusercontent.com

# Cờ tổng kiểm soát Mock Data:
# - 'false': Chạy với Backend thật (mặc định)
# - 'true' : Ép buộc mọi API dùng Mock Data trong bộ nhớ
VITE_USE_MOCK=false

# Cờ kiểm soát Mock Data độc lập theo từng Workstream:
# (Chỉ có tác dụng khi VITE_USE_MOCK=false)
# Đặt 'true' nếu bạn đang phát triển cục bộ và muốn dùng Mock cho riêng module đó.
VITE_MOCK_WS1=false  # Workstream 1: Customer Portal, Tra cứu & Đặt chỗ
VITE_MOCK_WS2=false  # Workstream 2: Staff Desk, Bàn giao, Check-in, Trả kho
VITE_MOCK_WS3=false  # Workstream 3: Quản lý Biểu giá BOM, Thanh toán VietQR / PayOS
VITE_MOCK_WS4=false  # Workstream 4: Quản lý Nhân sự, Báo cáo & Hỗ trợ Ticket
