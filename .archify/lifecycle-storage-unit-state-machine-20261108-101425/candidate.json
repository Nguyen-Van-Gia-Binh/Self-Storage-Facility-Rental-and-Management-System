  "cards": [
    {
      "dot": "cyan",
      "title": "Chu trinh Van hanh Tieu chuan",
      "items": [
        "AVAILABLE: Trang thai mac dinh khi tao o kho moi, san sang cho khach thue qua so do 2D",
        "RESERVED: Giu cho sau khi thanh toan coc (ReservationStatus=CONFIRMED) hoac sau khi don dep cho khach ke tiep",
        "OCCUPIED: Staff check-in ban giao cap ma PIN dien tu 6 so, hoac Cron tu dong kich hoat tai moc T+11",
        "CLEANING: Khi khach tra kho nghiem thu (FS-04) hoac thanh ly hop dong, o kho tu dong chuyen sang ve sinh",
        "Hoan tat don dep: POST /contracts/{id}/cleaning-complete chuyen ve AVAILABLE (neu khong co ai cho) hoac RESERVED"
      ]
    },
    {
      "dot": "amber",
      "title": "Quan ly Bao tri & Niem phong Tai san",
      "items": [
        "Bao tri dinh ky: FM/Staff chu dong dua o kho AVAILABLE sang MAINTENANCE de bao duong dinh ky",
        "Su co ban giao: Khach tu choi nhan kho do hu hong (BR-CHK-06), o kho RESERVED lap tuc vao MAINTENANCE de sua chua",
        "Niem phong cuong che D+10: Hop dong qua han 10 ngay (BR-OVD-05/07), o kho OCCUPIED vao MAINTENANCE de niem phong tai san ton",
        "Giai toa tu dong D+15: OverdueProcessingServiceImpl tu dong giai toa o kho ve AVAILABLE hoac RESERVED tai moc D+15"
      ]
    },
    {
      "dot": "slate",
      "title": "Cach ly & Ngung Phuc vu (OUT_OF_SERVICE)",
      "items": [
        "Ngung khai thac: BOM hoac FM cach ly o kho khoi he thong tinh capacity cho thue do cai tao ha tang co so",
        "Hu hong nang: O kho trong MAINTENANCE phat hien hu hong ket cau nghiem trong duoc chuyen sang OUT_OF_SERVICE",
        "Tai kich hoat: Sau khi hoan tat sua chua lon hoac het thoi gian phong toa, o kho tro lai AVAILABLE hoac MAINTENANCE"
      ]
    },
    {
      "dot": "emerald",
      "title": "Ma tran Rang buoc canTransitionTo",
      "items": [
        "AVAILABLE -> {RESERVED, MAINTENANCE, OUT_OF_SERVICE}",
        "RESERVED -> {OCCUPIED, AVAILABLE} (va MAINTENANCE qua quy trinh su co ban giao)",
        "OCCUPIED -> {CLEANING, MAINTENANCE} (Cam thay doi truc tiep qua API updateStatus khi dang OCCUPIED)",
        "CLEANING -> {AVAILABLE, RESERVED, MAINTENANCE}",
        "MAINTENANCE -> {AVAILABLE, RESERVED, CLEANING, OUT_OF_SERVICE}",
        "OUT_OF_SERVICE -> {AVAILABLE, MAINTENANCE}"
      ]
    }
  ]
