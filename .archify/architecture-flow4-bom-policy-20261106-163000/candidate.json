  "cards": [
    {
      "dot": "cyan",
      "title": "Master Unit Type vs Facility Override (BM-01 & BM-03)",
      "items": [
        "Unit Type Master định nghĩa diện tích chuẩn (m²) và SKU toàn hệ thống",
        "Mỗi cơ sở (Facility) được cấu hình đơn giá m²/tháng riêng biệt tuân thủ bội số 1,000 VND (BR-PRI-01)",
        "Giá tháng tính tự động: monthly_price = ROUND(price_per_m2 * width_m * length_m, -3)"
      ]
    },
    {
      "dot": "rose",
      "title": "Bất biến Bảng giá & Hợp đồng (Immutable Price Versioning)",
      "items": [
        "Bảng facility_unit_type_price_version lưu vết toàn bộ lịch sử tăng/giảm giá kèm effective_from",
        "Hợp đồng thuê khi tạo sẽ chốt snapshot đơn giá tại thời điểm ký kết, không bị biến động khi BOM đổi giá",
        "AppliedPriceLookup đảm bảo chỉ quote và áp dụng phiên bản đã có hiệu lực (effective_from <= CURRENT_DATE)"
      ]
    },
    {
      "dot": "emerald",
      "title": "Chính sách Toàn cục & Bảo vệ Đa tầng (@PreAuthorize ROLE_BOM)",
      "items": [
        "Chính sách cọc, hoàn tiền và phí quá hạn quản lý tập trung qua policy_version",
        "Số version tự động tăng lũy tiến (Auto Increment), BOM có thể tự nhập versionNo duy nhất",
        "Phân quyền cấp độ method security: Chỉ tài khoản có ROLE_BOM mới có quyền cập nhật bảng giá và ban hành chính sách"
      ]
    }
  ]
