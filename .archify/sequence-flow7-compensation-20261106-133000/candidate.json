    {
      "dot": "cyan",
      "title": "Nghiệm thu Đa kênh & Đối soát Chứng từ",
      "items": [
        "Nhân viên bắt buộc tải lên tối thiểu ảnh hiện trạng trước và sau xử lý (tối đa 5 ảnh) vào bảng support_attachment",
        "Khoản bồi thường được khấu trừ trực tiếp vào tiền thuê tháng tiếp theo hoặc hoàn trả qua tài khoản ngân hàng",
        "Cron SupportAutoCloseJob tự động đóng sau 48h chỉ áp dụng khi relocation_required = false"
