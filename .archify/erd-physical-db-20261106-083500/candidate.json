  "cards": [
    {
      "dot": "cyan",
      "title": "3NF Physical Schema & V1-V13 Migrations",
      "items": [
        "V1 Baseline: 10 core tables with surrogate BIGINT primary keys and unique business keys (email, code, version_no).",
        "V6 & V7: rental_contract relaxes storage_unit_id to nullable for PENDING check-in state, adding scheduled_start_time and scheduled_end_time.",
        "V10 & V13: Telesales CRM waitlist table added with direct contact_phone and conversion foreign keys to reservation and rental_contract; unit_type enriched with SKU dimensions (pallet_capacity, max_load_kg_m2, environment, features).",
        "V12: app_user protected with anti-spam throttle columns (daily_cancel_count, last_cancel_date per BR-SPAM-01)."
      ]
    },
    {
      "dot": "amber",
      "title": "Relationship Cardinality & Optionality",
      "items": [
        "Strict 1:1 business constraints: rental_contract enforces uq_reservation_id, and handover_record enforces uq_contract_id.",
        "Deferred & Optional Foreign Keys (drawn dashed): storage_unit_id on reservation and contract is optional prior to unit assignment; waitlist conversion links (converted_reservation_id, converted_contract_id) are nullable.",
        "Payment Dual Polymorphism: payment_transaction conditionally links to reservation_id (initial deposit) or contract_id (recurring/overdue/refunds)."
      ]
    },
    {
      "dot": "emerald",
      "title": "Domain Bands & Flow Architecture",
      "items": [
        "identity: Centralized account security, roles, and anti-spam quota enforcement.",
        "catalog: Physical facilities, expanded SKU specifications, and storage unit inventory.",
        "pricing: Dynamic pricing matrix (facility_unit_type_price) synced with policy versions.",
        "rental_core & billing: End-to-end customer journey from waitlist interest through booking, check-in handover, and financial settlement."
      ]
    }
  ]
}