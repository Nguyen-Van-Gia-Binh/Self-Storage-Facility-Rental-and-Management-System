  "cards": [
    {
      "dot": "cyan",
      "title": "Defense-in-Depth Pipeline",
      "items": [
        "Tầng 1: Route Guard ngăn chặn truy cập trái phép phía Frontend trước khi gửi HTTP request",
        "Tầng 2: JwtAuthenticationFilter giải mã và xác thực Bearer token stateless",
        "Tầng 3: Method Security (@PreAuthorize) chặn đứng lời gọi hàm nếu sai Role"
      ]
    },
    {
      "dot": "rose",
      "title": "Multi-Facility RBAC (SA-03 & BR-GEN-07)",
      "items": [
        "ADMIN và BOM sở hữu quyền toàn cục trên tất cả các cơ sở kho (isGlobalManagerOrAdmin)",
        "FACILITY_MANAGER và FACILITY_STAFF bị giới hạn nghiêm ngặt theo bảng user_facility_assignment",
        "Ngăn chặn triệt để lỗ hổng tráo ID cơ sở (IDOR) bằng SpEL canAccessFacility(#facilityId)"
      ]
    },
    {
      "dot": "emerald",
      "title": "Audit Vault & Compliance Evidence",
      "items": [
        "Bảng audit_log ghi nhận dấu vết toàn bộ hành vi CRUD nhạy cảm kèm before_value / after_value",
        "LoginHistory lưu vết địa chỉ IP, User-Agent và thời điểm đăng nhập thành công/thất bại",
        "Thời gian toàn hệ thống chuẩn hóa theo UTC+7 (Asia/Ho_Chi_Minh) theo quy tắc BR-GEN-06"
      ]
    }
  ]
