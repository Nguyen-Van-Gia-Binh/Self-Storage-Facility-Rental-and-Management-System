  "cards": [
    {
      "dot": "emerald",
      "title": "Multi-Facility Hierarchy (SA-03)",
      "items": [
        "Each physical facility is completely quarantined in terms of operational data and access permissions",
        "Staff and Facility Managers assigned to HCM-Q7 cannot view, modify, or assign tasks in HN-CauGiay",
        "Enforced both in database schema (facility_id foreign keys) and Spring Security SpEL expressions"
      ]
    },
    {
      "dot": "cyan",
      "title": "Physical Containment Model",
      "items": [
        "Storage units inherit dimensions and standard pricing from BOM-defined UnitType entities",
        "Arranged by Floor and Position within each facility for precise customer navigation during check-in",
        "Real-time status tracking: AVAILABLE, RESERVED, OCCUPIED, MAINTENANCE, OUT_OF_SERVICE"
      ]
    },
    {
      "dot": "violet",
      "title": "Dynamic Daily Staff Task Binding",
      "items": [
        "Staff members are not statically tied to units, but are dispatched daily to tasks across the facility",
        "Supports Handover tasks, Return inspection tasks, and Support incident resolution",
        "Workload view enables balanced task distribution and prevent staff overload during peak hours"
      ]
    }
  ]
