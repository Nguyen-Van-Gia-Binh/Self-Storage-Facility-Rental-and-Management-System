  "cards": [
    {
      "dot": "emerald",
      "title": "BOM Master Catalog Authority (BR-FM-01)",
      "items": [
        "Facility Manager creates StorageUnit instances by selecting approved UnitType models defined centrally by BOM",
        "Prevents arbitrary unit sizing or unauthorized pricing definitions at local facility levels",
        "Enforces storage unit code uniqueness (facility_id + code) with 409 Conflict rejection"
      ]
    },
    {
      "dot": "cyan",
      "title": "Dynamic Daily Dispatch Engine (FM-05 / FS-06)",
      "items": [
        "Replaces rigid static staff assignment with dynamic daily shift assignments in staff_daily_assignment",
        "Supports 3 key field work types: Handover (Check-in), Return Inspection, and Support Ticket Incident resolution",
        "Includes instant staff reassign capabilities if an assigned staff member is absent or overwhelmed"
      ]
    },
    {
      "dot": "rose",
      "title": "Safety Locks & Integrity Guardrails (BR-BOM-02)",
      "items": [
        "Soft Delete Protection: Storage units cannot be inactivated or deleted if status is OCCUPIED or RESERVED",
        "Immediate Maintenance Quarantine: Damaged or leaking units transition to MAINTENANCE, automatically suppressing check-in allocation",
        "Strict Multi-Facility Isolation (SA-03): FacilitySecurityService prevents IDOR across distinct facility IDs"
      ]
    }
  ]
