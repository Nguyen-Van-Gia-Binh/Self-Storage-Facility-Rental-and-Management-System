                    <mxGeometry x="285" y="45" width="30" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="bom_login" value="Đăng nhập tài khoản BOM (SCR-SYS-01)&#10;Nhập thông tin xác thực quản trị viên" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e7f5ff;strokeColor=#1971c2;" parent="lane_bom" vertex="1">
                    <mxGeometry x="175" y="100" width="250" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="edge_start_to_login" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" parent="lane_bom" source="start_node" target="bom_login" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="bom_hub" value="BOM Operations Hub (Menu quản trị):&#10;Truy cập cổng điều hành kinh doanh tập trung" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e7f5ff;strokeColor=#1971c2;" parent="lane_bom" vertex="1">
                    <mxGeometry x="175" y="180" width="250" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="fork_menu" value="" style="shape=line;strokeWidth=6;strokeColor=#212529;html=1;" parent="lane_bom" vertex="1">
                    <mxGeometry x="30" y="260" width="540" height="10" as="geometry"/>
                </mxCell>
                <mxCell id="edge_hub_to_fork" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" parent="lane_bom" source="bom_hub" target="fork_menu" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="sec1_label" value="&lt;b style=&quot;color: #1c7ed6;&quot;&gt;PHÂN HỆ 1: QUẢN LÝ MẠNG LƯỚI CƠ SỞ TOÀN HỆ THỐNG (BM-01)&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;" parent="lane_bom" vertex="1">
                    <mxGeometry x="40" y="285" width="450" height="20" as="geometry"/>
                </mxCell>
                <mxCell id="bom_f4_01" value="UC-F4-01 (BM-01 · SCR-BM-01):&#10;Quản lý danh sách cơ sở toàn quốc:&#10;• Thêm mới Facility (Mã, Tên, Địa chỉ)&#10;• Chỉnh sửa thông tin cơ sở Active&#10;• Ngừng khai thác cơ sở (Inactive)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e7f5ff;strokeColor=#1971c2;align=left;spacingLeft=8;" parent="lane_bom" vertex="1">
                    <mxGeometry x="40" y="310" width="270" height="95" as="geometry"/>
                </mxCell>
                <mxCell id="sec2_label" value="&lt;b style=&quot;color: #1c7ed6;&quot;&gt;PHÂN HỆ 2: THIẾT LẬP CHÍNH SÁCH THUÊ &amp;amp; THAM SỐ NGHIỆP VỤ (BM-02)&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;" parent="lane_bom" vertex="1">
                    <mxGeometry x="40" y="585" width="480" height="20" as="geometry"/>
                </mxCell>
                <mxCell id="bom_f4_02_05" value="Cấu hình chính sách thuê cơ bản (BM-02 · SCR-BM-02):&#10;• UC-F4-02 (Deposit): deposit.multiplier (1.0), reservation.hold_hours (48h) (BR-DEP-01, 03)&#10;• UC-F4-03 (Renewal): renewal.reminder_days (nhắc trước 2 tháng &amp;amp; 7, 3, 1 ngày trước mốc khóa 1 tháng), min 1 tháng, max 12 tháng (BR-REN-01, 03, 07)&#10;• UC-F4-04 (Cancellation): cancel.full_refund_hours (48h hoàn 100%), late 50%, no-show 0%, checkin.grace_days (10 ngày) (BR-CAN-01..05)&#10;• UC-F4-05 (Return): return.notice_days (30 ngày), return.refund_working_days (7 ngày), early_refund 0% (BR-RET-01..06)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e7f5ff;strokeColor=#1971c2;align=left;spacingLeft=8;" parent="lane_bom" vertex="1">
                    <mxGeometry x="40" y="610" width="520" height="120" as="geometry"/>
                </mxCell>
                <mxCell id="bom_f4_06" value="UC-F4-06 (BM-02 · SCR-BM-02):&#10;Thiết lập chính sách Overdue &amp;amp; Các mốc xử lý quá hạn (BR-OVD-01..05):&#10;• Ân hạn D+1..D+3: overdue.grace_days = 3 ngày (nhắc mỗi ngày, miễn phí phạt, hoàn 100% cọc nếu dọn xong)&#10;• Phí phạt D+4..D+10: overdue.daily_rate = 10% cọc/ngày (tối đa 7 ngày tính phí)&#10;• Trần phí quá hạn: overdue.cap_rate = 70% tiền cọc Deposit&#10;• Chấm dứt &amp;amp; Khóa kho: overdue.lock_access_days = 10, overdue.termination_days = 10&#10;  → Chạm mốc D+10: chấm dứt hợp đồng, khóa mã PIN, cấn trừ cọc, niêm phong đồ về kho tổng" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff3bf;strokeColor=#f59f00;align=left;spacingLeft=8;" parent="lane_bom" vertex="1">
                    <mxGeometry x="40" y="750" width="520" height="120" as="geometry"/>
                </mxCell>
                <mxCell id="sec3_label" value="&lt;b style=&quot;color: #1c7ed6;&quot;&gt;PHÂN HỆ 3: QUẢN LÝ KHUNG GIÁ, PHỤ PHÍ &amp;amp; ƯU ĐÃI (BM-03)&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;" parent="lane_bom" vertex="1">
                    <mxGeometry x="40" y="975" width="480" height="20" as="geometry"/>
                </mxCell>
                <mxCell id="bom_f4_07_09" value="Quản lý bảng giá thuê, phụ phí &amp;amp; ưu đãi (BM-03 · SCR-BM-03):&#10;• UC-F4-07: Đặt đơn giá thuê tháng theo từng cặp Unit Type × Facility (VND/tháng)&#10;• UC-F4-08: Quản lý biểu phí phạt quá hạn (10%/ngày) &amp;amp; danh mục phụ phí dịch vụ (cấp lại thẻ, PIN...)&#10;• UC-F4-09: Ban hành chương trình giảm giá / khuyến mãi theo thời gian hiệu lực và phạm vi cơ sở&#10;  (Lưu ý BR-OVD-10: Hệ thống không hỗ trợ tính năng đề xuất duyệt miễn giảm phí quá hạn theo vụ)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e7f5ff;strokeColor=#1971c2;align=left;spacingLeft=8;" parent="lane_bom" vertex="1">
                    <mxGeometry x="40" y="1000" width="520" height="110" as="geometry"/>
                </mxCell>
                <mxCell id="sec4_label" value="&lt;b style=&quot;color: #1c7ed6;&quot;&gt;PHÂN HỆ 4: GIÁM SÁT HIỆU QUẢ VẬN HÀNH &amp;amp; XUẤT BÁO CÁO BI (BM-04, BM-05)&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;" parent="lane_bom" vertex="1">
                    <mxGeometry x="40" y="1275" width="520" height="20" as="geometry"/>
                </mxCell>
                <mxCell id="bom_f4_10_11" value="Truy cập Dashboard BI &amp;amp; Lọc số liệu (BM-04 · SCR-BM-04):&#10;• Chọn khoảng thời gian (kỳ báo cáo theo ngày/tháng/quý)&#10;• Chọn phạm vi cơ sở: Toàn hệ thống hoặc một Facility&#10;• Chọn phân loại Unit Type / Loại doanh thu" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e7f5ff;strokeColor=#1971c2;align=left;spacingLeft=8;" parent="lane_bom" vertex="1">
                    <mxGeometry x="40" y="1300" width="280" height="85" as="geometry"/>
                </mxCell>
                <mxCell id="bom_f4_12" value="UC-F4-12 (BM-05 · SCR-BM-04):&#10;Xem Dashboard trực quan &amp;amp;&#10;Yêu cầu kết xuất file báo cáo (CSV/PDF)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e7f5ff;strokeColor=#1971c2;" parent="lane_bom" vertex="1">
                    <mxGeometry x="340" y="1300" width="220" height="85" as="geometry"/>
                </mxCell>
                <mxCell id="edge_fork_to_f4_01" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" parent="lane_bom" source="fork_menu" target="bom_f4_01" edge="1">
