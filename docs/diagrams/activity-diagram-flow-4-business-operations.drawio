                </mxCell>
                <mxCell id="lane_system" value="&lt;b style=&quot;font-size: 14px;&quot;&gt;System (Hệ thống)&lt;/b&gt;" style="swimlane;whiteSpace=wrap;html=1;startSize=30;fillColor=#f8f9fa;strokeColor=#495057;" parent="1" vertex="1">
                    <mxGeometry x="640" y="80" width="620" height="1620" as="geometry"/>
                </mxCell>
                <mxCell id="sys_auth" value="Xác thực danh tính &amp;amp; Kiểm tra quyền RBAC:&#10;Cấp quyền quản trị toàn hệ thống theo vai trò BOM (US-SA-02.1)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d3f9d8;strokeColor=#2b8a3e;" parent="lane_system" vertex="1">
                    <mxGeometry x="150" y="100" width="320" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="sys_val_f4_01" value="Kiểm tra hợp lệ &amp;amp; Ràng buộc cơ sở (US-BM-01.1, 01.2):&#10;• Kiểm tra trùng mã cơ sở, trường bắt buộc Tên, Địa chỉ&#10;• Nếu Inactive: Kiểm tra không còn hợp đồng Active/Overdue&#10;  và không còn Reservation Confirmed giữ capacity" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff3bf;strokeColor=#f59f00;align=left;spacingLeft=8;" parent="lane_system" vertex="1">
                    <mxGeometry x="40" y="310" width="340" height="85" as="geometry"/>
                </mxCell>
                <mxCell id="sys_save_f4_01" value="Lưu bản ghi &amp;amp; Cập nhật trạng thái Facility:&#10;• Active: Cơ sở hiển thị công khai tìm kiếm (UC-F1-01)&#10;• Inactive: Ẩn khỏi hệ thống, chặn đặt chỗ mới&#10;• Gửi thông báo đến Facility Manager quản lý cơ sở" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d3f9d8;strokeColor=#2b8a3e;align=left;spacingLeft=8;" parent="lane_system" vertex="1">
                    <mxGeometry x="40" y="420" width="340" height="85" as="geometry"/>
                </mxCell>
                <mxCell id="edge_sys_val_to_save_f4_01" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" parent="lane_system" source="sys_val_f4_01" target="sys_save_f4_01" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="end_f4_01" value="" style="ellipse;html=1;shape=endState;fillColor=#212529;strokeColor=#212529;" parent="lane_system" vertex="1">
                    <mxGeometry x="195" y="530" width="30" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="edge_save_to_end_f4_01" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" parent="lane_system" source="sys_save_f4_01" target="end_f4_01" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="sys_val_f4_02_06" value="Kiểm tra hợp lệ tham số nghiệp vụ (US-BM-02.1..02.5):&#10;• Các tỷ lệ hoàn tiền &amp;amp; phí phạt trong đoạn [0%..100%]&#10;• Thứ tự bắt buộc các mốc quá hạn (US-BM-02.5 AC-3):&#10;  Ân hạn (D+3) &lt; Bắt đầu phạt (D+4) &lt;= Khóa &amp;amp; Chấm dứt (D+10)&#10;• Số nguyên dương: hold_hours, grace_days, min_months..." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff3bf;strokeColor=#f59f00;align=left;spacingLeft=8;" parent="lane_system" vertex="1">
                    <mxGeometry x="40" y="680" width="340" height="95" as="geometry"/>
                </mxCell>
                <mxCell id="sys_save_f4_02_06" value="Ban hành phiên bản chính sách mới (Policy Versioning):&#10;• Ghi nhận phiên bản có hiệu lực vào bảng cấu hình (BR § 2)&#10;• Quy tắc KHÔNG HỒI TỐ (BR-GEN-01, BR-GEN-02): Hợp đồng &amp;amp;&#10;  Reservation đã ký giữ nguyên snapshot phiên bản tại thời điểm tạo&#10;• Cung cấp tham số cho Flow 1, 2, 3 và Scheduled Jobs Flow 6" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d3f9d8;strokeColor=#2b8a3e;align=left;spacingLeft=8;" parent="lane_system" vertex="1">
                    <mxGeometry x="40" y="800" width="340" height="95" as="geometry"/>
                </mxCell>
                <mxCell id="edge_sys_val_to_save_f4_02" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" parent="lane_system" source="sys_val_f4_02_06" target="sys_save_f4_02_06" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="end_f4_02_06" value="" style="ellipse;html=1;shape=endState;fillColor=#212529;strokeColor=#212529;" parent="lane_system" vertex="1">
                    <mxGeometry x="195" y="915" width="30" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="edge_save_to_end_f4_02" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" parent="lane_system" source="sys_save_f4_02_06" target="end_f4_02_06" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="sys_val_f4_07_09" value="Kiểm tra tính hợp lệ bảng giá &amp;amp; phụ phí (US-BM-03.1..03.3):&#10;• Đơn giá thuê &gt; 0, làm tròn đến 1.000 đ (BR-GEN-04)&#10;• Không xóa phụ phí đang gán cho hợp đồng chưa quyết toán&#10;• Tỷ lệ giảm giá &lt;= 100%, thời gian kết thúc &gt;= bắt đầu" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff3bf;strokeColor=#f59f00;align=left;spacingLeft=8;" parent="lane_system" vertex="1">
                    <mxGeometry x="40" y="1000" width="340" height="80" as="geometry"/>
                </mxCell>
                <mxCell id="sys_save_f4_07_09" value="Lưu Snapshot đơn giá theo Unit Type × Facility (BR-GEN-05):&#10;• Cập nhật bảng giá niêm yết theo từng cơ sở&#10;• Áp dụng cho các Reservation và gia hạn Renewal tạo sau thời điểm lưu&#10;• Hợp đồng đang thuê giữ nguyên đơn giá snapshot ban đầu" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d3f9d8;strokeColor=#2b8a3e;align=left;spacingLeft=8;" parent="lane_system" vertex="1">
                    <mxGeometry x="40" y="1105" width="340" height="85" as="geometry"/>
                </mxCell>
                <mxCell id="edge_sys_val_to_save_f4_07" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" parent="lane_system" source="sys_val_f4_07_09" target="sys_save_f4_07_09" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="end_f4_07_09" value="" style="ellipse;html=1;shape=endState;fillColor=#212529;strokeColor=#212529;" parent="lane_system" vertex="1">
                    <mxGeometry x="195" y="1215" width="30" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="edge_save_to_end_f4_07" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" parent="lane_system" source="sys_save_f4_07_09" target="end_f4_07_09" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="sys_calc_f4_10_11" value="Tự động tổng hợp số liệu phân tích BI (US-BM-04.1, 04.2):&#10;• UC-F4-10: Tổng hợp doanh thu thực tế, bóc tách dòng tiền:&#10;  Cọc Deposit, Tiền thuê, Phí gia hạn, Phí quá hạn, Phụ phí&#10;• UC-F4-11: Tính tỷ lệ lấp đầy cơ sở:&#10;  Usage Rate = Số ô Occupied / (Tổng ô - Out of service)&#10;• Thống kê trạng thái hợp đồng: Active, Overdue, Terminated" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d3f9d8;strokeColor=#2b8a3e;align=left;spacingLeft=8;" parent="lane_system" vertex="1">
                    <mxGeometry x="40" y="1295" width="350" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="sys_export_f4_12" value="Kết xuất file báo cáo BI chuẩn hóa (US-BM-05.1):&#10;• Tạo file CSV / PDF chứa đúng số liệu đa chiều đang hiển thị&#10;• Metadata: Kỳ báo cáo, người xuất (BOM), timestamp (Asia/Ho_Chi_Minh)&#10;• Ghi nhật ký trích xuất báo cáo độc lập vào Audit Trail" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d3f9d8;strokeColor=#2b8a3e;align=left;spacingLeft=8;" parent="lane_system" vertex="1">
                    <mxGeometry x="40" y="1425" width="350" height="85" as="geometry"/>
                </mxCell>
                <mxCell id="end_f4_10_12" value="" style="ellipse;html=1;shape=endState;fillColor=#212529;strokeColor=#212529;" parent="lane_system" vertex="1">
                    <mxGeometry x="200" y="1535" width="30" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="edge_export_to_end_f4_12" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" parent="lane_system" source="sys_export_f4_12" target="end_f4_10_12" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="lane_fm" value="&lt;b style=&quot;font-size: 14px;&quot;&gt;Facility Manager (Quản lý cơ sở - Tác nhân liên quan)&lt;/b&gt;" style="swimlane;whiteSpace=wrap;html=1;startSize=30;fillColor=#f8f9fa;strokeColor=#495057;" parent="1" vertex="1">
                    <mxGeometry x="1260" y="80" width="450" height="1620" as="geometry"/>
                </mxCell>
                <mxCell id="fm_receive_f4_01" value="Tiếp nhận thông tin cơ sở mới / cập nhật:&#10;→ Chuyển tiếp sang FLOW 5 (UC-F5-01, UC-F5-02):&#10;Khởi tạo sơ đồ mặt bằng, danh mục loại kho Unit Type,&#10;danh sách ô kho Storage Unit và phân công nhân sự ca trực" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e7f5ff;strokeColor=#1971c2;align=left;spacingLeft=8;" parent="lane_fm" vertex="1">
                    <mxGeometry x="35" y="420" width="380" height="85" as="geometry"/>
                </mxCell>
                <mxCell id="legend_box" value="&lt;b style=&quot;font-size: 13px;&quot;&gt;CHÚ GIẢI &amp;amp; BẢN ĐỒ TÍCH HỢP HỆ THỐNG FLOW 4&lt;/b&gt;&lt;br&gt;&lt;hr&gt;&#10;&lt;b&gt;Tác nhân chính:&lt;/b&gt; Business Operations Manager (BOM) · &lt;b&gt;Liên quan:&lt;/b&gt; Facility Manager (FM)&lt;br&gt;&#10;&lt;b&gt;Phạm vi yêu cầu:&lt;/b&gt; BM-01 đến BM-05 (12 Use Cases: UC-F4-01 đến UC-F4-12)&lt;br&gt;&lt;br&gt;&#10;&lt;b style=&quot;color: #1c7ed6;&quot;&gt;Đầu ra của Flow 4 cung cấp cho các luồng nghiệp vụ khác:&lt;/b&gt;&lt;br&gt;&#10;• &lt;b&gt;UC-F4-01 (Cơ sở):&lt;/b&gt; Cung cấp dữ liệu Facility cho Flow 5 (Vận hành kho) và Flow 1 (Tìm kiếm kho)&lt;br&gt;&#10;• &lt;b&gt;UC-F4-02..05 (Chính sách):&lt;/b&gt; Flow 1 đọc Deposit &amp;amp; Hold 48h; Flow 2 đọc Checkin Grace 10 ngày;&#10;  Flow 3 đọc Return Notice 30 ngày &amp;amp; Quyết toán; Flow 6 đọc lịch nhắc Renewal&lt;br&gt;&#10;• &lt;b&gt;UC-F4-06 (Overdue):&lt;/b&gt; Cung cấp bộ tham số D+1..D+3 (ân hạn), D+4..D+10 (phạt 10%/ngày),&#10;  D+10 (chấm dứt &amp;amp; niêm phong kho) cho Scheduled Job Flow 6.2&lt;br&gt;&#10;• &lt;b&gt;UC-F4-07..09 (Giá &amp;amp; Phí):&lt;/b&gt; Flow 1 đọc Snapshot giá; Flow 2, 3 đọc danh mục phụ phí&lt;br&gt;&#10;• &lt;b&gt;UC-F4-10..12 (BI &amp;amp; Báo cáo):&lt;/b&gt; Thu nhận dữ liệu giao dịch thời gian thực từ Flow 1, 2, 3, 6" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f1f3f5;strokeColor=#ced4da;align=left;spacingLeft=10;spacingTop=8;verticalAlign=top;" parent="lane_fm" vertex="1">
