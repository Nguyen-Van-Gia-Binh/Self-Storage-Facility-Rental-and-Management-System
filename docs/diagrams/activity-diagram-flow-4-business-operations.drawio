    <diagram name="Flow-4-Business-Operations" id="flow-4-business-operations">
        <mxGraphModel dx="1037" dy="1583" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1750" pageHeight="1750" math="0" shadow="0">
            <root>
