                <mxCell id="title_header" value="&lt;b style=&quot;font-size: 16px;&quot;&gt;FLOW 4: Business Rules, Fee Management and Revenue Monitoring Flow (Vận hành kinh doanh, Chính sách &amp;amp; Doanh thu)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size: 12px; color: #555555;&quot;&gt;Cấu hình tham số nghiệp vụ toàn hệ thống · Quản lý cơ sở · Khung giá &amp;amp; Phụ phí · Giám sát doanh thu &amp;amp; Báo cáo BI toàn diện&lt;/span&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;" parent="1" vertex="1">
                    <mxGeometry x="40" y="20" width="1200" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="lane_bom" value="&lt;b style=&quot;font-size: 14px;&quot;&gt;Business Operations Manager (Quản lý vận hành kinh doanh)&lt;/b&gt;" style="swimlane;whiteSpace=wrap;html=1;startSize=30;fillColor=#f8f9fa;strokeColor=#495057;" parent="1" vertex="1">
                    <mxGeometry x="40" y="80" width="600" height="1620" as="geometry"/>
                </mxCell>
