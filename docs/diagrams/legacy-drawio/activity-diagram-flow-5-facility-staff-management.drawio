                <mxCell id="edge_fm_to_fs_tasks" value="Phân công nhiệm vụ ca trực" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#1971c2;" parent="1" source="fm_uc_f5_04" target="fs_uc_f5_05" edge="1">
