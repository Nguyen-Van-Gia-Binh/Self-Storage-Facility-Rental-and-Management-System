@startuml erd-1-identity-facility
!pragma layout smetana
skinparam dpi 150
skinparam defaultFontName Arial
skinparam roundcorner 6
skinparam shadowing false
hide circle

title Physical ERD — Part 1: Identity, Security & Facility Domain

entity "app_user" as app_user {
  * id : BIGINT <<PK, GENERATED>>
  --
  * email : VARCHAR(150) <<UNIQUE>>
  * password_hash : VARCHAR(255)
  * full_name : VARCHAR(100)
  * phone_number : VARCHAR(20) <<UNIQUE>>
  * role : VARCHAR(30)
  * status : VARCHAR(20)
  citizen_id : VARCHAR(20)
  address : VARCHAR(255)
  daily_cancel_count : INT
  last_cancel_date : DATE
  * created_at : TIMESTAMPTZ
  * updated_at : TIMESTAMPTZ
}

entity "user_facility_assignment" as user_facility_assignment {
  * id : BIGINT <<PK, GENERATED>>
  --
  * user_id : BIGINT <<FK>>
  * facility_id : BIGINT <<FK>>
  assigned_at : TIMESTAMPTZ
}

entity "login_history" as login_history {
  * id : BIGINT <<PK, GENERATED>>
  --
  * user_id : BIGINT <<FK>>
  * login_time : TIMESTAMPTZ
  ip_address : VARCHAR(45)
  user_agent : VARCHAR(255)
  status : VARCHAR(20)
}

entity "audit_log" as audit_log {
  * id : BIGINT <<PK, GENERATED>>
  --
  user_id : BIGINT <<FK>>
  * action : VARCHAR(100)
  * entity_name : VARCHAR(100)
  entity_id : BIGINT
  old_value : JSONB
  new_value : JSONB
  * created_at : TIMESTAMPTZ
}

entity "registration_otp" as registration_otp {
  * id : BIGINT <<PK, GENERATED>>
  --
  * email : VARCHAR(150)
  * otp_code : VARCHAR(10)
  * expires_at : TIMESTAMPTZ
  is_used : BOOLEAN
  * created_at : TIMESTAMPTZ
}

entity "password_reset_otp" as password_reset_otp {
  * id : BIGINT <<PK, GENERATED>>
  --
  * email : VARCHAR(150)
  * otp_code : VARCHAR(10)
  * expires_at : TIMESTAMPTZ
  is_used : BOOLEAN
  * created_at : TIMESTAMPTZ
}

entity "facility" as facility {
  * id : BIGINT <<PK, GENERATED>>
  --
  * code : VARCHAR(50) <<UNIQUE>>
  * name : VARCHAR(150)
  * address : VARCHAR(255)
  * city : VARCHAR(50)
  * district : VARCHAR(50)
  * status : VARCHAR(20)
  phone : VARCHAR(20)
  total_units : INT
  operating_hours : VARCHAR(100)
  created_at : TIMESTAMPTZ
  updated_at : TIMESTAMPTZ
}

entity "unit_type" as unit_type {
  * id : BIGINT <<PK, GENERATED>>
  --
  * code : VARCHAR(50) <<UNIQUE>>
  * name : VARCHAR(100)
  category : VARCHAR(50)
  * length_meters : NUMERIC(5,2)
  * width_meters : NUMERIC(5,2)
  * height_meters : NUMERIC(5,2)
  * area_sqm : NUMERIC(5,2)
  * volume_cbm : NUMERIC(6,2)
  * base_price : NUMERIC(12,2)
  description : TEXT
  sku : VARCHAR(50)
}

entity "facility_unit_type_price" as facility_unit_type_price {
  * id : BIGINT <<PK, GENERATED>>
  --
  * facility_id : BIGINT <<FK>>
  * unit_type_id : BIGINT <<FK>>
  * monthly_price : NUMERIC(12,2)
  version_number : INT
  created_at : TIMESTAMPTZ
  updated_at : TIMESTAMPTZ
}

entity "facility_unit_type_price_version" as facility_unit_type_price_version {
  * id : BIGINT <<PK, GENERATED>>
  --
  * facility_id : BIGINT <<FK>>
  * unit_type_id : BIGINT <<FK>>
  * version_number : INT
  * monthly_price : NUMERIC(12,2)
  * effective_from : TIMESTAMPTZ
  effective_to : TIMESTAMPTZ
  created_by : BIGINT <<FK>>
  created_at : TIMESTAMPTZ
}

entity "storage_unit" as storage_unit {
  * id : BIGINT <<PK, GENERATED>>
  --
  * facility_id : BIGINT <<FK>>
  * unit_type_id : BIGINT <<FK>>
  * unit_number : VARCHAR(50)
  * floor_level : INT
  zone : VARCHAR(50)
  * status : VARCHAR(20)
  grid_row : INT
  grid_col : INT
  created_at : TIMESTAMPTZ
  updated_at : TIMESTAMPTZ
}

' Relationships
app_user ||--o{ user_facility_assignment : "user_id"
facility ||--o{ user_facility_assignment : "facility_id"
app_user ||--o{ login_history : "user_id"
app_user |o--o{ audit_log : "user_id"
facility ||--|{ storage_unit : "facility_id"
unit_type ||--|{ storage_unit : "unit_type_id"
facility ||--|{ facility_unit_type_price : "facility_id"
unit_type ||--|{ facility_unit_type_price : "unit_type_id"
facility ||--o{ facility_unit_type_price_version : "facility_id"
unit_type ||--o{ facility_unit_type_price_version : "unit_type_id"
app_user |o--o{ facility_unit_type_price_version : "created_by"

@enduml

