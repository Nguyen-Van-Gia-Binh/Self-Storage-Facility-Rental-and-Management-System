@startuml erd-2-booking-contract
!pragma layout smetana
skinparam dpi 150
skinparam defaultFontName Arial
skinparam roundcorner 6
skinparam shadowing false
hide circle

title Physical ERD — Part 2: Booking, Waitlist, Contract & Handover Domain

' Reference stubs
entity "app_user" as app_user {
  * id : BIGINT <<PK>>
}
entity "facility" as facility {
  * id : BIGINT <<PK>>
}
entity "unit_type" as unit_type {
  * id : BIGINT <<PK>>
}
entity "storage_unit" as storage_unit {
  * id : BIGINT <<PK>>
}

entity "reservation" as reservation {
  * id : BIGINT <<PK, GENERATED>>
  --
  * reservation_code : VARCHAR(50) <<UNIQUE>>
  * user_id : BIGINT <<FK>>
  * facility_id : BIGINT <<FK>>
  * unit_type_id : BIGINT <<FK>>
  storage_unit_id : BIGINT <<FK>>
  * expected_start_date : DATE
  * rental_duration_months : INT
  * expected_end_date : DATE
  * deposit_amount : NUMERIC(12,2)
  * monthly_rental_fee : NUMERIC(12,2)
  * total_initial_payment : NUMERIC(12,2)
  * status : VARCHAR(30)
  cancellation_reason : TEXT
  policy_version_id : BIGINT
  discount_program_id : BIGINT
  created_at : TIMESTAMPTZ
  updated_at : TIMESTAMPTZ
}

entity "waitlist" as waitlist {
  * id : BIGINT <<PK, GENERATED>>
  --
  * user_id : BIGINT <<FK>>
  * facility_id : BIGINT <<FK>>
  * unit_type_id : BIGINT <<FK>>
  * desired_start_date : DATE
  contact_phone : VARCHAR(20)
  note : TEXT
  * status : VARCHAR(30)
  created_at : TIMESTAMPTZ
  updated_at : TIMESTAMPTZ
}

entity "rental_contract" as rental_contract {
  * id : BIGINT <<PK, GENERATED>>
  --
  * code : VARCHAR(50) <<UNIQUE>>
  * customer_id : BIGINT <<FK>>
  * facility_id : BIGINT <<FK>>
  * storage_unit_id : BIGINT <<FK>>
  reservation_id : BIGINT <<FK>>
  * start_date : DATE
  * end_date : DATE
  * monthly_rate : NUMERIC(12,2)
  * deposit_amount : NUMERIC(12,2)
  * status : VARCHAR(30)
  pin_code_hash : VARCHAR(255)
  pin_code_salt : VARCHAR(255)
  scheduled_checkin_date : DATE
  scheduled_checkin_time_slot : VARCHAR(50)
  created_at : TIMESTAMPTZ
  updated_at : TIMESTAMPTZ
}

entity "contract_renewal" as contract_renewal {
  * id : BIGINT <<PK, GENERATED>>
  --
  * contract_id : BIGINT <<FK>>
  * extension_months : INT
  * previous_end_date : DATE
  * new_end_date : DATE
  * renewal_rate : NUMERIC(12,2)
  status : VARCHAR(30)
  created_at : TIMESTAMPTZ
}

entity "handover_record" as handover_record {
  * id : BIGINT <<PK, GENERATED>>
  --
  * contract_id : BIGINT <<FK, UNIQUE>>
  staff_id : BIGINT <<FK>>
  handover_date : TIMESTAMPTZ
  is_clean : BOOLEAN
  is_lock_working : BOOLEAN
  is_light_working : BOOLEAN
  is_climate_working : BOOLEAN
  customer_signature : TEXT
  notes : TEXT
  created_at : TIMESTAMPTZ
}

entity "return_request" as return_request {
  * id : BIGINT <<PK, GENERATED>>
  --
  * contract_id : BIGINT <<FK>>
  * requested_return_date : DATE
  actual_return_date : DATE
  is_clean : BOOLEAN
  damage_fee : NUMERIC(12,2)
  refund_deposit_amount : NUMERIC(12,2)
  penalty_amount : NUMERIC(12,2)
  settlement_paid_at : TIMESTAMPTZ
  notes : TEXT
  * status : VARCHAR(30)
  staff_id : BIGINT <<FK>>
  created_at : TIMESTAMPTZ
  updated_at : TIMESTAMPTZ
}

entity "access_credential" as access_credential {
  * id : BIGINT <<PK, GENERATED>>
  --
  * contract_id : BIGINT <<FK>>
  credential_type : VARCHAR(50)
  credential_value_hash : VARCHAR(255)
  is_active : BOOLEAN
  issued_at : TIMESTAMPTZ
  revoked_at : TIMESTAMPTZ
}

entity "access_log" as access_log {
  * id : BIGINT <<PK, GENERATED>>
  --
  * storage_unit_id : BIGINT <<FK>>
  contract_id : BIGINT <<FK>>
  * access_time : TIMESTAMPTZ
  access_point : VARCHAR(50)
  status : VARCHAR(20)
}

' Domain Links
app_user ||--o{ reservation : "user_id"
facility ||--o{ reservation : "facility_id"
unit_type ||--o{ reservation : "unit_type_id"
storage_unit |o--o{ reservation : "storage_unit_id"

app_user ||--o{ waitlist : "user_id"
facility ||--o{ waitlist : "facility_id"
unit_type ||--o{ waitlist : "unit_type_id"

app_user ||--o{ rental_contract : "customer_id"
facility ||--o{ rental_contract : "facility_id"
storage_unit ||--o{ rental_contract : "storage_unit_id"
reservation |o--o| rental_contract : "reservation_id"

rental_contract ||--o{ contract_renewal : "contract_id"
rental_contract ||--o| handover_record : "contract_id"
app_user |o--o{ handover_record : "staff_id"
rental_contract ||--o{ return_request : "contract_id"
app_user |o--o{ return_request : "staff_id"

rental_contract ||--o{ access_credential : "contract_id"
storage_unit ||--o{ access_log : "storage_unit_id"
rental_contract |o--o{ access_log : "contract_id"

@enduml

