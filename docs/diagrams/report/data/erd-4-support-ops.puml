@startuml erd-4-support-ops
!pragma layout smetana
skinparam dpi 150
skinparam defaultFontName Arial
skinparam roundcorner 6
skinparam shadowing false
hide circle

title Physical ERD — Part 4: Customer Support, Attachments & Operations Domain

' Reference stubs
entity "app_user" as app_user {
  * id : BIGINT <<PK>>
}
entity "facility" as facility {
  * id : BIGINT <<PK>>
}
entity "rental_contract" as rental_contract {
  * id : BIGINT <<PK>>
}

entity "support_request" as support_request {
  * id : BIGINT <<PK, GENERATED>>
  --
  * ticket_code : VARCHAR(50) <<UNIQUE>>
  * user_id : BIGINT <<FK>>
  facility_id : BIGINT <<FK>>
  contract_id : BIGINT <<FK>>
  assigned_to_user_id : BIGINT <<FK>>
  * title : VARCHAR(200)
  * description : TEXT
  * category : VARCHAR(50)
  priority : VARCHAR(20)
  * status : VARCHAR(30)
  resolution_notes : TEXT
  resolved_at : TIMESTAMPTZ
  rating : INT
  created_at : TIMESTAMPTZ
  updated_at : TIMESTAMPTZ
}

entity "attachment" as attachment {
  * id : BIGINT <<PK, GENERATED>>
  --
  * entity_name : VARCHAR(100)
  * entity_id : BIGINT
  * file_name : VARCHAR(255)
  * file_url : VARCHAR(500)
  file_size_bytes : BIGINT
  mime_type : VARCHAR(100)
  uploaded_by : BIGINT <<FK>>
  uploaded_at : TIMESTAMPTZ
}

entity "staff_daily_assignment" as staff_daily_assignment {
  * id : BIGINT <<PK, GENERATED>>
  --
  * facility_id : BIGINT <<FK>>
  * staff_id : BIGINT <<FK>>
  * shift_date : DATE
  shift_type : VARCHAR(50)
  notes : TEXT
  created_at : TIMESTAMPTZ
}

' Links
app_user ||--o{ support_request : "user_id (requester)"
facility |o--o{ support_request : "facility_id"
rental_contract |o--o{ support_request : "contract_id"
app_user |o--o{ support_request : "assigned_to_user_id (staff)"

facility ||--o{ staff_daily_assignment : "facility_id"
app_user ||--o{ staff_daily_assignment : "staff_id"

app_user |o--o{ attachment : "uploaded_by"

@enduml

