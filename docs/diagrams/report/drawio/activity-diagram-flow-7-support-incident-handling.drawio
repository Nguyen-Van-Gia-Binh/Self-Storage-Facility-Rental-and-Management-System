                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="mgr_dec_urgent" value="Sự cố khẩn cấp truy cập?&#10;(Quên PIN, kẹt khóa, mất chìa)" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff3bf;strokeColor=#f59f00;" parent="lane_mgr" vertex="1">
                    <mxGeometry x="160" y="535" width="220" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="edge_mgr_04_to_dec" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" parent="lane_mgr" source="mgr_uc_f7_04" target="mgr_dec_urgent" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="mgr_sla_urgent" value="Áp đặt mức độ ưu tiên &amp;amp; cam kết SLA (BR-SUP-01):&#10;• Đánh dấu cờ khẩn cấp &quot;High Priority&quot; trên ticket (US-FM-05.1 AC-2)&#10;• Kích hoạt SLA support.urgent_sla_hours = 2 giờ&#10;• Bắt buộc nhân viên cơ sở tiếp nhận và bắt đầu xử lý trong 2 giờ" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe3e3;strokeColor=#e03131;align=left;spacingLeft=8;" parent="lane_mgr" vertex="1">
                    <mxGeometry x="60" y="660" width="420" height="75" as="geometry"/>
                </mxCell>
                <mxCell id="edge_dec_to_sla" value="Khẩn cấp" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" parent="lane_mgr" source="mgr_dec_urgent" target="mgr_sla_urgent" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="mgr_legend_box" value="&lt;b style=&quot;font-size: 13px; color: #343a40;&quot;&gt;ĐẶC TẢ NGHIỆP VỤ &amp;amp; QUY TẮC RÀNG BUỘC (BUSINESS RULES):&lt;/b&gt;&lt;br&gt;&lt;br&gt;• &lt;b&gt;Nguồn kích hoạt Flow 7:&lt;/b&gt;&lt;br&gt;  - Khách hàng báo sự cố trên ứng dụng/portal (SC-06).&lt;br&gt;  - Kích hoạt từ Flow 2 (Handover): Phát hiện ô kho lỗi kết cấu/vệ sinh lúc nhận, khách từ chối ký biên bản (BR-CHK-06).&lt;br&gt;  - Kích hoạt từ Flow 3 (Return): Tranh chấp biên bản kiểm tra hư hỏng khi khách trả kho (BR-RET-08).&lt;br&gt;&lt;br&gt;• &lt;b&gt;BR-SUP-01 (SLA khẩn cấp tại chỗ):&lt;/b&gt; Mất chìa, quên PIN, kẹt khóa bắt buộc xử lý trong &lt;b&gt;support.urgent_sla_hours = 2 giờ&lt;/b&gt;.&lt;br&gt;• &lt;b&gt;BR-SUP-02 (Trách nhiệm &amp;amp; chi phí hư hại):&lt;/b&gt;&lt;br&gt;  - Do hạ tầng cơ sở (dột, chập điện): Cơ sở chịu 100% chi phí; dột lớn ưu tiên di dời đồ sang ô kho dự phòng.&lt;br&gt;  - Do khách chủ quan: Tính chi phí sửa chữa theo bảng phụ phí BM-03.&lt;br&gt;• &lt;b&gt;BR-SUP-03 (Nghiệm thu &amp;amp; Đóng ticket):&lt;/b&gt; Staff bắt buộc tải ảnh sau sửa; nếu khách không phản hồi trong &lt;b&gt;support.auto_close_working_days = 7 ngày làm việc&lt;/b&gt;, hệ thống tự đóng ticket.&lt;br&gt;• &lt;b&gt;BR-ACC-03 (Thẩm quyền truy cập):&lt;/b&gt; Chỉ chủ hợp đồng hoặc người ủy quyền hợp lệ mới được cấp lại PIN/QR/khóa cơ." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f1f3f5;strokeColor=#868e96;align=left;spacingLeft=8;verticalAlign=top;" parent="lane_mgr" vertex="1">
                    <mxGeometry x="40" y="1240" width="460" height="440" as="geometry"/>
                </mxCell>
