                <mxCell id="fm_assign_staff" value="Tiếp nhận thông báo Contract bị chấm dứt tại D+10;&#10;Xem danh mục nhiệm vụ dọn kho hệ thống tự tạo;&#10;Phân bổ nhân viên Facility Staff thực hiện&#10;dọn dẹp ô kho và niêm phong đồ đạc (US-FM-04.3)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe3e3;strokeColor=#e03131;" parent="lane_fm" vertex="1">
