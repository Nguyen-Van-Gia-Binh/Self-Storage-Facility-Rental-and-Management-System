                <mxCell id="fm_monitor_overdue" value="Theo dõi danh sách hợp đồng quá hạn tại cơ sở;&#10;Kiểm tra các mốc cảnh báo nợ trên Dashboard (UC-F6-10)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f1f3f5;strokeColor=#495057;" parent="lane_fm" vertex="1">
