                <mxCell id="cust_settle_debt" value="Thanh toán toàn bộ nợ phạt kèm phí kỳ mới (BR-OVD-08);&#10;Hoặc yêu cầu trả kho sớm trước D+10 để giảm phạt;&#10;Nợ quá hạn được cấn trừ cùng Deposit (BR-RET-11)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d3f9d8;strokeColor=#2b8a3e;" parent="lane_customer" vertex="1">
