                <mxCell id="fm_offline_custody" value="Tiếp nhận tài sản tồn đọng và biên bản niêm phong;&#10;Quản lý lưu giữ đồ đạc tại kho lưu trữ tổng cơ sở;&#10;Tự liên hệ khách và xử lý thủ công ngoại tuyến (offline)&#10;(Phần mềm không hỗ trợ quy trình thanh lý phức tạp — BR-OVD-11)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f1f3f5;strokeColor=#495057;" parent="lane_fm" vertex="1">
