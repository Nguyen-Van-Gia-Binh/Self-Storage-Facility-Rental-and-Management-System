                <mxCell id="cust_receive_grace" value="Nhận thông báo nhắc dọn đồ trong 3 ngày ân hạn;&#10;Xem trạng thái hợp đồng và hạn chót không tính phí;&#10;Mã PIN/QR vẫn mở cửa kho bình thường (US-SC-05.5)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e7f5ff;strokeColor=#1971c2;" parent="lane_customer" vertex="1">
