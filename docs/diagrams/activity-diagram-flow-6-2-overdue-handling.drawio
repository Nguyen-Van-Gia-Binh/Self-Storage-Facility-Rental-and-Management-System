                </mxCell>
                <mxCell id="edge_restore_to_end" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" parent="lane_system" source="sys_restore_contract" target="end_restored" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="sys_terminate_d10" value="Chạm mốc D+10 (00:00 ngày D+11) (UC-F6-07, UC-F6-11):&#10;- Tự động khóa Access Code sang Suspended (BR-OVD-05)&#10;- Chốt trần phí phạt quá hạn = 70% tiền cọc (7 ngày x 10%) (BR-OVD-04)&#10;- Cấn trừ toàn bộ phí nợ phạt vào tiền cọc Deposit&#10;- Chuyển trạng thái hợp đồng sang TERMINATED_OVERDUE (BR-OVD-07)&#10;- Chuyển trạng thái Storage Unit sang Cleaning / Maintaining&#10;- Tự động sinh nhiệm vụ dọn kho cho cơ sở (UC-F6-09)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe3e3;strokeColor=#e03131;" parent="lane_system" vertex="1">
                    <mxGeometry x="55" y="1350" width="330" height="120" as="geometry"/>
                </mxCell>
                <mxCell id="lane_customer" value="&lt;b style=&quot;font-size: 14px;&quot;&gt;Storage Customer (Khách hàng)&lt;/b&gt;" style="swimlane;whiteSpace=wrap;html=1;startSize=30;fillColor=#f8f9fa;strokeColor=#495057;" parent="1" vertex="1">
                    <mxGeometry x="480" y="80" width="360" height="1820" as="geometry"/>
