                <mxCell id="start_node" value="" style="ellipse;fillColor=#212529;strokeColor=#212529;html=1;" parent="lane_system" vertex="1">
                    <mxGeometry x="205" y="45" width="30" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="sys_pre_condition" value="Hợp đồng không gia hạn trước mốc 1 tháng (T - 30 ngày);&#10;Hệ thống đã kích hoạt tiến trình Chuẩn bị trả kho (Return);&#10;Đến ngày kết thúc T: Khách chưa dọn đồ &amp;amp; chưa nghiệm thu" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e7f5ff;strokeColor=#1971c2;" parent="lane_system" vertex="1">
                    <mxGeometry x="80" y="105" width="280" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="edge_start_to_pre" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" parent="lane_system" source="start_node" target="sys_pre_condition" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="sys_job_d1" value="Tác vụ quét định kỳ lúc 00:00 ngày D+1 (UC-F6-05):&#10;- Phát hiện hợp đồng hết hạn chưa hoàn tất trả kho&#10;- Chuyển trạng thái Contract sang Overdue (BR-OVD-01)&#10;- Bắt đầu giai đoạn ân hạn overdue.grace_days = 3 ngày" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e7f5ff;strokeColor=#1971c2;" parent="lane_system" vertex="1">
                    <mxGeometry x="75" y="210" width="290" height="80" as="geometry"/>
                </mxCell>
                <mxCell id="edge_pre_to_d1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" parent="lane_system" source="sys_pre_condition" target="sys_job_d1" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="sys_notice_grace" value="Tác vụ tự động giai đoạn Ân hạn D+1 đến D+3:&#10;- Gửi thông báo nhắc dọn đồ hằng ngày qua app &amp;amp; email (UC-F6-08)&#10;- Chưa tính phí quá hạn (phí phạt = 0 đ) (BR-OVD-02)&#10;- Quyền truy cập Access Code (PIN/QR) vẫn mở bình thường" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e7f5ff;strokeColor=#1971c2;" parent="lane_system" vertex="1">
                    <mxGeometry x="70" y="325" width="300" height="85" as="geometry"/>
                </mxCell>
                <mxCell id="edge_d1_to_grace" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" parent="lane_system" source="sys_job_d1" target="sys_notice_grace" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="sys_refund_100_deposit" value="Nghiệm thu ô kho đạt yêu cầu (Khớp Flow 3: Return);&#10;Tất toán hợp đồng không tính phí quá hạn (BR-OVD-02);&#10;Hoàn trả 100% tiền cọc Deposit về phương thức gốc;&#10;Chuyển Contract sang Closed, Storage Unit sang Available" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d3f9d8;strokeColor=#2b8a3e;" parent="lane_system" vertex="1">
                    <mxGeometry x="70" y="660" width="300" height="80" as="geometry"/>
                </mxCell>
                <mxCell id="end_grace_success" value="" style="ellipse;html=1;shape=endState;fillColor=#212529;strokeColor=#212529;" parent="lane_system" vertex="1">
                    <mxGeometry x="205" y="775" width="30" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="edge_refund_to_end" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" parent="lane_system" source="sys_refund_100_deposit" target="end_grace_success" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="sys_calc_penalty" value="Tác vụ tự động hằng ngày từ D+4 đến D+10 (UC-F6-06):&#10;- Tính phí quá hạn = 10% tiền cọc / ngày (BR-OVD-03)&#10;- Cộng dồn phí phạt nợ vào hợp đồng thuê&#10;- Gửi thông báo nhắc dọn đồ &amp;amp; cảnh báo nợ mỗi ngày (UC-F6-08)&#10;- Cảnh báo hạn chót D+10 sẽ bị chấm dứt hợp đồng" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff3bf;strokeColor=#f59f00;" parent="lane_system" vertex="1">
                    <mxGeometry x="65" y="870" width="310" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="sys_restore_contract" value="Ghi nhận thanh toán thành công (BR-OVD-08, BR-REN-06);&#10;Khấu trừ toàn bộ phí quá hạn đã tích lũy;&#10;Mở lại hợp đồng Active &amp;amp; quyền truy cập Access Code;&#10;Hoặc hoàn tất thủ tục trả kho theo thỏa thuận (BR-RET-11)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d3f9d8;strokeColor=#2b8a3e;" parent="lane_system" vertex="1">
                    <mxGeometry x="70" y="1160" width="300" height="75" as="geometry"/>
