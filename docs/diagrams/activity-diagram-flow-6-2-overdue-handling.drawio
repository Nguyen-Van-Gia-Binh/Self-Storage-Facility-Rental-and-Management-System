    <diagram name="Flow-6-2-Overdue-Handling" id="flow-6-2-overdue-handling">
        <mxGraphModel dx="1155" dy="1118" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1950" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="title_header" value="&lt;b style=&quot;font-size: 16px;&quot;&gt;FLOW 6: Sub-flow 6.2 — Overdue Handling (Xử lý hợp đồng quá hạn &amp;amp; Tài sản tồn đọng)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size: 12px; color: #555555;&quot;&gt;Tác vụ tự động quét D+1 · Ân hạn D+1..D+3 (hoàn cọc nếu dọn xong) · Tính phí 10% cọc/ngày D+4..D+10 · D+10 khóa kho, chấm dứt &amp;amp; niêm phong đồ về kho tổng&lt;/span&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;" parent="1" vertex="1">
                    <mxGeometry x="40" y="20" width="1100" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="lane_system" value="&lt;b style=&quot;font-size: 14px;&quot;&gt;System (Hệ thống)&lt;/b&gt;" style="swimlane;whiteSpace=wrap;html=1;startSize=30;fillColor=#f8f9fa;strokeColor=#495057;" parent="1" vertex="1">
                    <mxGeometry x="40" y="80" width="440" height="1820" as="geometry"/>
